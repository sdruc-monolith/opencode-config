{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "openai/gpt-5.6-luna",
  "agent": {
    "explore": {
      "model": "openai/gpt-5.6-luna",
      "variant": "xhigh"
    },
    "general": {
      "model": "openai/gpt-5.6-luna",
      "variant": "xhigh"
    }
  },
  "mcp": {
    "duckduckgo": {
      "type": "local",
      "command": [
        "uvx",
        "duckduckgo-mcp-server"
      ]
    },
    "alphaxiv": {
      "type": "remote",
      "url": "https://api.alphaxiv.org/mcp/v1",
      "oauth": false
    },
    "zotero": {
      "type": "local",
      "command": [
        "zotero-mcp"
      ],
      "timeout": 120000,
      "environment": {
        "ZOTERO_LOCAL": "{env:ZOTERO_LOCAL}",
        "ZOTERO_API_KEY": "{env:ZOTERO_API_KEY}",
        "ZOTERO_LIBRARY_ID": "{env:ZOTERO_LIBRARY_ID}",
        "ZOTERO_LIBRARY_TYPE": "{env:ZOTERO_LIBRARY_TYPE}"
      }
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"]
    }
  },
  "experimental": {
    "openTelemetry": true
  }
}
